# =============================================================================
# Task Manager - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for local development.
# Never commit real secrets.
#
# At least one authentication method must be configured:
#   - GitHub OAuth (AUTH_GITHUB_ID + AUTH_GITHUB_SECRET)
#   - Google OAuth (AUTH_GOOGLE_ID + AUTH_GOOGLE_SECRET)
#   - Email + Password (AUTH_EMAIL_ENABLED=true)
#
# AUTH_SECRET must be at least 32 characters.
# Generate with: openssl rand -base64 32
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js ---
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth (optional; both or neither)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (optional; both or neither)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + Password (recommended for local / E2E)
AUTH_EMAIL_ENABLED=true

# --- Local SQLite (next dev / seeds / Vitest) ---
SQLITE_DB_PATH=.data/local.sqlite

# --- Cloudflare / D1 ---
# Local Wrangler uses wrangler.jsonc bindings (task-manager-dev).
# Production uses env.production → task-manager-prod.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_NAME=task-manager-dev
CLOUDFLARE_D1_DATABASE_ID=

# =============================================================================
# Production (Cloudflare Workers / OpenNext)
# =============================================================================
# Do not put production secrets in this file. Set them with:
#
#   pnpm exec wrangler secret put AUTH_SECRET --env production
#   pnpm exec wrangler secret put AUTH_URL --env production
#   pnpm exec wrangler secret put NEXT_PUBLIC_APP_URL --env production
#
# Optional OAuth:
#   pnpm exec wrangler secret put AUTH_GITHUB_ID --env production
#   pnpm exec wrangler secret put AUTH_GITHUB_SECRET --env production
#   pnpm exec wrangler secret put AUTH_GOOGLE_ID --env production
#   pnpm exec wrangler secret put AUTH_GOOGLE_SECRET --env production
#
# AUTH_EMAIL_ENABLED is set as a plain var in wrangler.jsonc (production).
# After first deploy, set AUTH_URL / NEXT_PUBLIC_APP_URL to the workers.dev
# (or custom domain) HTTPS URL.
# =============================================================================
