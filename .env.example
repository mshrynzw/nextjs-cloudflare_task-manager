# =============================================================================
# Task Manager - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for local development.
# Never commit real secrets.
#
# Authentication providers are enabled in this order:
#   1. GitHub OAuth (when AUTH_GITHUB_ID / AUTH_GITHUB_SECRET are set)
#   2. Google OAuth (when AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET are set)
#   3. Email + Password (when AUTH_EMAIL_ENABLED=true)
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js (Phase 3) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth (implement / enable first)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (implement / enable second)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + Password (implement / enable third)
AUTH_EMAIL_ENABLED=true

# --- Cloudflare / D1 (Phase 2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_NAME=task-manager-dev
CLOUDFLARE_D1_DATABASE_ID=

# Local SQLite used by Next.js Auth / seed scripts
SQLITE_DB_PATH=.data/local.sqlite
