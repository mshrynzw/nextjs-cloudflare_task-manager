# =============================================================================
# Task Manager - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in values for local development.
# Never commit real secrets.
#
# Authentication providers will be enabled in Phase 3 in this order:
#   1. GitHub OAuth (required first)
#   2. Google OAuth
#   3. Email + Password
# =============================================================================

# --- App ---
# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth.js (Phase 3) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical auth URL (usually same as NEXT_PUBLIC_APP_URL in local/dev)
AUTH_URL=http://localhost:3000

# GitHub OAuth (implement first)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (implement second)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email + Password (implement third)
# Set to true when Credentials provider is enabled
AUTH_EMAIL_ENABLED=false

# --- Cloudflare / D1 (Phase 2) ---
# Binding name in wrangler.jsonc is DB.
# Dev database name is task-manager-dev (see wrangler.jsonc for database_id).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_NAME=task-manager-dev
CLOUDFLARE_D1_DATABASE_ID=

# Optional: local SQLite file used by pnpm db:seed:local
# SQLITE_DB_PATH=.data/local.sqlite
